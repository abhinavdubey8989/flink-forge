# Contains common env variables for all shell scripts


# Current repo directory
PROJECT_DIR=$HOME/Documents/ad/flink-forge


# JAR file DIR after running : build-shadow-jar.sh
HOST_JAR_FILE_DIR=$HOME/Documents/ad/flink-forge/build/libs


# bind-mount dir on host-machine for flink job-manager (JM) & task-manager (TM) to read the JAR files from
HOST_FLINK_BIND_MOUNT_DIR_FOR_JAR=$HOME/Documents/ad/docker-lab/flink/job-jars


# JAR file-name
JAR_FILE_NAME=flink-forge-0.0.1.jar


# Docker container name of the flink JM & TM
FLINK_JM_CONTAINER_NAME=flink-jobmanager
FLINK_TM_CONTAINER_NAME=flink-taskmanager

# JAR dir inside the container
CONTAINER_JAR_DIR=/opt/flink/job-jars
